{
  "speech": {
    "vosk_model_path": "models/vosk-model-small-en-us-0.15"
  },
  "server": {
    "host": "192.168.1.10",
    "bind": "0.0.0.0",
    "port": 5067
  },
  "options": {
    "max_history_messages": 18,
    "keep_audio_files": false,
    "conversation_timeout_minutes": 30,
    "ffmpeg_path": "path/to/ffmpeg/ffmpeg.exe"
  }
}
